{
	"name": "n8n-nodes-mailsenpai",
	"version": "0.1.0",
	"description": "n8n community nodes for the SMTP Senpai API by MailSenpai: send transactional email, read delivery events, manage the suppression list.",
	"license": "MIT",
	"homepage": "https://en.mailsenpai.com/smtp-api/",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"smtp",
		"email",
		"transactional-email",
		"mailsenpai",
		"smtp-senpai"
	],
	"author": {
		"name": "MailSenpai",
		"email": "supporto@mailsenpai.com",
		"url": "https://en.mailsenpai.com/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mailsenpai/n8n-nodes-mailsenpai.git"
	},
	"bugs": {
		"url": "https://github.com/mailsenpai/n8n-nodes-mailsenpai/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SmtpSenpaiApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/SmtpSenpai/SmtpSenpai.node.js",
			"dist/nodes/SmtpSenpaiTrigger/SmtpSenpaiTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.51.4",
		"eslint": "9.39.4",
		"n8n-workflow": "2.16.0",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
